{% extends 'base.html.twig' %}

{% block title %}Cours index{% endblock %}

{% block body %}
    <h1>Cours index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>TypeEntrainement</th>
                <th>Description</th>
                <th>Prix</th>
                <th>EsCollectif</th>
                <th>NbChienMax</th>
                <th>Duree</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for cour in cours %}
            <tr>
                <td>{{ cour.id }}</td>
                <td>{{ cour.typeEntrainement }}</td>
                <td>{{ cour.description }}</td>
                <td>{{ cour.prix }}</td>
                <td>{{ cour.esCollectif ? 'Yes' : 'No' }}</td>
                <td>{{ cour.nbChienMax }}</td>
                <td>{{ cour.duree }}</td>
                <td>
                    <a href="{{ path('adminAfficheUnCours', {'id': cour.id}) }}">show</a>
                    <a href="{{ path('adminModifierUnCours', {'id': cour.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('adminAjoutCours') }}">Create new</a>
{% endblock %}
