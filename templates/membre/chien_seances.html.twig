{% extends 'base.html.twig' %}

{% block title %}Séances de {{ chien.nom }}{% endblock %}

{% block body %}
<style>
    /* Une petite touche de style personnalisé */
    .table-container { border-radius: 12px; overflow: hidden; }
    .dog-name { font-weight: 700; border-bottom: 3px solid #0d6efd; padding-bottom: 2px; }
    .table thead { background-color: #f8f9fa; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; }
    .badge-custom { padding: 0.5em 0.8em; border-radius: 6px; }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="h2 mb-1">Carnet de séances</h1>
            <p class="text-muted">Suivi des entraînements pour <span class="dog-name text-primary">{{ chien.nom }}</span></p>
        </div>
        <a href="{{ path('espace_chien', {'id': chien.proprietaire.id}) }}" class="btn btn-outline-secondary rounded-pill">
            <i class="fas fa-arrow-left me-2"></i>Retour à l'espace
        </a>
    </div>

    {% if inscriptions is empty %}
        <div class="text-center py-5 bg-light rounded-4 border border-dashed">
            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">Aucune séance planifiée</h4>
            <p>Il semblerait que {{ chien.nom }} n'ait pas encore de rendez-vous à l'agenda.</p>
        </div>
    {% else %}
        <div class="card shadow-sm border-0 table-container">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Date & Heure</th>
                                <th><i class="fas fa-clock me-2"></i>Durée</th>
                                <th><i class="fas fa-graduation-cap me-2"></i>Niveau</th>
                                <th>Type d'exercice</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for inscription in inscriptions %}
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">{{ inscription.seance.date }}</div>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-secondary">{{ inscription.seance.cours.duree }} min</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-soft-primary text-primary border border-primary-subtle">
                                            {{  inscription.seance.cours.niveauxApprentissage.libelle }}
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark badge-custom">
                                            {{ inscription.seance.cours.typeEntrainement }}
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                         <form method="post" action="{{ path('membreSuppressionInscription', {'id': inscription.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ inscription.id) }}">
                <button class="btn btn-danger btn-sm">Supprimer</button>
            </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}