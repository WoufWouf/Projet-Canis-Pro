{% extends 'base.html.twig' %}

{% block title %}Proprietaire index{% endblock %}

{% block body %}
    <h1>Proprietaire index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prenom</th>
                <th>Email</th>
                <th>Tel</th>
                <th>Date_Naissance</th>
                <th>Adresse</th>
                <th>Code_Postal</th>
                <th>Ville</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for proprietaire in proprietaires %}
            <tr>
                <td>{{ proprietaire.id }}</td>
                <td>{{ proprietaire.Nom }}</td>
                <td>{{ proprietaire.Prenom }}</td>
                <td>{{ proprietaire.email }}</td>
                <td>{{ proprietaire.tel }}</td>
                <td>{{ proprietaire.dateNaissance }}</td>
                <td>{{ proprietaire.Adresse }}</td>
                <td>{{ proprietaire.CodePostal }}</td>
                <td>{{ proprietaire.Ville }}</td>
                <td>
                    <a href="{{ path('app_proprietaire_show', {'id': proprietaire.id}) }}">show</a>
                    <a href="{{ path('app_proprietaire_edit', {'id': proprietaire.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_proprietaire_new') }}">Create new</a>
{% endblock %}
