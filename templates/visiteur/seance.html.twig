{% extends 'base.html.twig' %}

{% block title %}Liste des Séances{% endblock %}
{% block head %} 
<style>
</style>

{% endblock %}

{% block body %}

    <h1>Prochaines Séances</h1>
<table>
        <thead>
            <tr>
                <th>Prochain Cours</th>
                <th>Date Prochain Cours</th>
                <th>Heure Prochain Cours</th>
            </tr>
        </thead>
<tbody>
    {% for seance in seances %}
        <tr>
            <td>{{ seance.cours.id }}</td>
            <td>{{ seance.date|date('d/m/Y') }}</td>
            <td>{{ seance.heure|date('H:i') }}</td>
            <td>
                {# les visiteurs ne peuvent pas inscrire de chien, rediriger vers l'espace membre #}
                <a href="{{ path('espace_personnel') }}">Se connecter pour inscrire votre chien</a>
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}