{# templates/inscription/new.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Nouvelle Inscription{% endblock %}

{% block body %}
    <h1>Nouvelle Inscription</h1>

    {{ form_start(form) }}
        {% if is_granted('ROLE_ADMIN') %}
        <div class="form-group" style="display: none;">
            {{ form_label(form.nb_Chien_Inscrit) }}
            {{ form_widget(form.nb_Chien_Inscrit, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.nb_Chien_Inscrit) }}
        </div>

        <div class="form-group" >
            {{ form_label(form.seances) }}
            {{ form_widget(form.seances, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.seances) }}
        </div>
        <div class="form-group" >
            {{ form_widget(form.chiens) }}
        </div>
        
        {% else %}
        <div class="form-group" >
            {{ form_widget(form.chiens) }}
        </div>

        <div class="form-group" style="display: none;">
            {{ form_label(form.nb_Chien_Inscrit) }}
            {{ form_widget(form.nb_Chien_Inscrit, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.nb_Chien_Inscrit) }}
        </div>

        <div class="form-group" style="display: none;">
            {{ form_label(form.seances) }}
            {{ form_widget(form.seances, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.seances) }}
        </div>
            <label>Choisir les chiens</label>
            {% for chien in chiens %}
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" 
                           id="chien_{{ chien.id }}" 
                           name="chiens[]" 
                           value="{{ chien.id }}">
                    <label class="form-check-label" for="chien_{{ chien.id }}">
                        {{ chien.nom }} ({{ chien.race }})
                    </label>
                </div>
            {% endfor %}
        </div>
        {% endif %}

       <div class="form-footer">
            {{ include('cours/_form.html.twig', {'button_label': ' Ajouter' , 'form_class': 'btn-edit'}) }}
</div>

    {{ form_end(form) }}
{% endblock %}